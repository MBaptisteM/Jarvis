#!/bin/bash

set -euo pipefail

echo "Uninstalling Jarvis..."


BIN_PATH="$HOME/.local/bin/jarvis"
LIB_PATH="$HOME/.local/lib/jarvis"
COMP_PATH="$HOME/.local/share/bash-completion/completions/jarvis"
if [ -d "$HOME/.config" ]; then
    JARVIS_DATA_PATH="$HOME/.config/.jarvis"
else
    JARVIS_DATA_PATH="$HOME/.jarvis"
fi


echo ""
echo "This action will remove:"
echo "  - $BIN_PATH"
echo "  - $LIB_PATH"
echo "  - $COMP_PATH"
echo "  - $JARVIS_DATA_PATH"
echo ""

printf "Are you sure you want to uninstall Jarvis? (y/N): "
IFS= read -r confirm

if [[ ! "$confirm" =~ ^([yY]|[yY][eE][sS])$ ]]; then
    echo "Uninstall cancelled."
    exit 0
fi

rm -f "$BIN_PATH" "$COMP_PATH"
rm -rf "$LIB_PATH" "$JARVIS_DATA_PATH"

echo ""
echo "Jarvis has been uninstalled successfully."