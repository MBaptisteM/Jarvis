#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-}"
URL="${2:-}"
SUBJECT_PATH="${3:-}"
FILE_NAME="${4:-"subject.html"}"
OTHER_PATH="${5:-}"

if [ -z "$MODE" ] || [ -z "$URL" ] || [ -z "$SUBJECT_PATH" ]; then
    echo "Usage: ./get_subject <setup|auth|auth-console|run|download> <url> <subject_path>"
    exit 1
fi

NIX_PROFILE_PATH="$HOME/.nix-profile/bin:$HOME/.local/state/nix/profiles/profile/bin"
export PATH="$NIX_PROFILE_PATH:$PATH"


#   - Node.js + the playwright npm package : every mode
#   - Chromium : only the modes that open a page (auth, auth-console, run).
#     "download" is a plain HTTP request with the saved session.
case "$MODE" in
    auth | auth-console | run | setup) NEED_CHROMIUM=1 ;;
    download) NEED_CHROMIUM=0 ;;
    *)
        echo "ERROR Unknown mode : $MODE" >&2
        exit 1
        ;;
esac

# Always shown (stderr), so the user knows what Jarvis is doing
say()
{
    printf '\033[1;36m[Jarvis]\033[0m %s\n' "$*" >&2
}

# --- Install methods -------------------------------------------------------
# Every method (nix, apt) is tried : the one saved in the info file first, else
# the one deduced from what is installed. When a method works while the expected
# one did not, the environment was wrongly deduced : the working method is saved
# in the info file ("install_method", same key as the C side) and is used first
# from now on. JARVIS_INFO_FILE is exported by Jarvis.
INSTALL_METHOD_KEY="install_method"

saved_method()
{
    [ -n "${JARVIS_INFO_FILE:-}" ] && [ -f "$JARVIS_INFO_FILE" ] || return 0
    sed -n "s/^[[:space:]]*\"$INSTALL_METHOD_KEY\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
        "$JARVIS_INFO_FILE" | head -n 1
}

save_method()
{
    [ -n "${JARVIS_INFO_FILE:-}" ] || return 0
    touch "$JARVIS_INFO_FILE" 2>/dev/null || return 0
    if grep -q "^[[:space:]]*\"$INSTALL_METHOD_KEY\"" "$JARVIS_INFO_FILE"; then
        sed -i "s|^[[:space:]]*\"$INSTALL_METHOD_KEY\".*|\"$INSTALL_METHOD_KEY\" : \"$1\",|" \
            "$JARVIS_INFO_FILE"
    else
        printf '"%s" : "%s",\n' "$INSTALL_METHOD_KEY" "$1" >> "$JARVIS_INFO_FILE"
    fi
}

# $1 = nixpkgs attribute. "nix profile add" only exists in recent Nix, older
# versions use "nix profile install" : both are tried.
try_nix()
{
    command -v nix >/dev/null 2>&1 || return 1
    nix profile add "nixpkgs#$1" < /dev/null \
        || nix profile install "nixpkgs#$1" < /dev/null
}

# $1 = nixpkgs attribute (unused), $2 = apt package(s)
try_apt()
{
    command -v apt-get >/dev/null 2>&1 || return 1
    local sudo=""
    if [ "$(id -u)" -ne 0 ]; then
        command -v sudo >/dev/null 2>&1 || return 1
        sudo="sudo"
    fi
    # shellcheck disable=SC2086
    $sudo apt-get install -y $2 \
        || { $sudo apt-get update && $sudo apt-get install -y $2; }
}

# install_pkg <binary> <nixpkgs attribute> <apt package(s)>
install_pkg()
{
    local binary="$1" nix_pkg="$2" apt_pkgs="$3"
    command -v "$binary" >/dev/null 2>&1 && return 0

    local saved expected other method
    saved="$(saved_method)"
    if [ "$saved" = nix ] || [ "$saved" = apt ]; then
        expected="$saved"
    elif command -v nix >/dev/null 2>&1; then
        expected=nix
    else
        expected=apt
    fi
    if [ "$expected" = nix ]; then other=apt; else other=nix; fi

    for method in "$expected" "$other"; do
        say "Installing '$binary' with $method..."
        if "try_$method" "$nix_pkg" "$apt_pkgs"; then
            export PATH="$NIX_PROFILE_PATH:$PATH"
            if command -v "$binary" >/dev/null 2>&1; then
                if [ "$method" != "$expected" ] || [ -z "$saved" ]; then
                    save_method "$method"
                fi
                if [ "$method" != "$expected" ]; then
                    say "'$expected' did not work but '$method' did : the install method is now set to '$method'."
                fi
                say "'$binary' installed."
                return 0
            fi
        fi
        echo "Installing '$binary' with $method failed." >&2
    done

    echo "Impossible to install '$binary' (tried : nix, apt). Install it manually (ex : sudo apt install $apt_pkgs)." >&2
    return 1
}


if [ "$MODE" = "setup" ]; then
    say "Checking the dependencies (Node.js, playwright, Chromium)..."
fi

# Node.js : the apt package "nodejs" does not always bring npm
install_pkg npm nodejs "nodejs npm" || exit 1


if [ ! -f "$SUBJECT_PATH/package.json" ]; then
    npm init -y --prefix "$SUBJECT_PATH" > /dev/null < /dev/null
fi

if [ ! -d "$SUBJECT_PATH/node_modules/playwright" ]; then
    say "Installing the 'playwright' npm package in $SUBJECT_PATH..."
    npm install playwright --prefix "$SUBJECT_PATH" --no-audit --no-fund < /dev/null
    say "'playwright' installed."
fi


if [ "$NEED_CHROMIUM" -eq 1 ]; then
    if [ -e /etc/NIXOS ] || grep -qi '^ID=nixos$' /etc/os-release 2>/dev/null; then
        # NixOS : use the Chromium of Nix
        if ! command -v chromium >/dev/null 2>&1 \
            && ! command -v chromium-browser >/dev/null 2>&1; then
            install_pkg chromium chromium chromium || exit 1
        fi

        if command -v chromium >/dev/null 2>&1; then
            export JARVIS_CHROMIUM_EXECUTABLE_PATH="$(command -v chromium)"
        elif command -v chromium-browser >/dev/null 2>&1; then
            export JARVIS_CHROMIUM_EXECUTABLE_PATH="$(command -v chromium-browser)"
        else
            echo "Chromium was installed but is not available in PATH." >&2
            exit 1
        fi
    else
        # Other systems : the Chromium downloaded by Playwright. Check the real
        # file instead of a marker, the cache can be wiped between two sessions.
        CHROMIUM_PATH="$(cd "$SUBJECT_PATH" \
            && node -e "process.stdout.write(require('playwright').chromium.executablePath())" \
            2>/dev/null || true)"
        if [ -z "$CHROMIUM_PATH" ] || [ ! -e "$CHROMIUM_PATH" ]; then
            say "Installing Chromium for Playwright (npx playwright install chromium)..."
            (cd "$SUBJECT_PATH" && npx playwright install chromium < /dev/null)
            say "Chromium installed."
        fi
    fi
fi

# "setup" only installs what is missing, nothing to run afterwards
if [ "$MODE" = "setup" ]; then
    say "Dependencies ready."
    exit 0
fi

node "$SUBJECT_PATH/get_subject.js" "$MODE" "$URL" "$SUBJECT_PATH" "$FILE_NAME" "$OTHER_PATH"

