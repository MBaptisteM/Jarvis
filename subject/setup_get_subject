#!/bin/bash
set -euo pipefail

MODE="${1:-}"
URL="${2:-}"
SUBJECT_PATH="${3:-}"
FILE_NAME="${4:-"subject.html"}"
OTHER_PATH="${5:-}"

if [ -z "$MODE" ] || [ -z "$URL" ] || [ -z "$SUBJECT_PATH" ]; then
    echo "Usage: ./get_subject <auth|run> <url> <subject_path>"
    exit 1
fi

PLAYWRIGHT_MARKER="$SUBJECT_PATH/.playwright_setup_done"

NEED_PLAYWRIGHT_NPM=0
NEED_SETUP=0

if ! command -v npm >/dev/null 2>&1; then
    if ! command -v nix >/dev/null 2>&1; then
        echo "npm is required. Install Node.js with: nix profile add nixpkgs#nodejs" >&2
        exit 1
    fi
    nix profile add nixpkgs#nodejs
    export PATH="$HOME/.nix-profile/bin:$HOME/.local/state/nix/profiles/profile/bin:$PATH"
fi

if ! command -v npm >/dev/null 2>&1; then
    echo "npm is still unavailable after installing Node.js with Nix." >&2
    exit 1
fi

if [ ! -f "$SUBJECT_PATH/package.json" ]; then
    npm init -y --prefix "$SUBJECT_PATH" > /dev/null
fi

if [ ! -d "$SUBJECT_PATH/node_modules/playwright" ]; then
    NEED_PLAYWRIGHT_NPM=1
fi

if [ ! -f "$PLAYWRIGHT_MARKER" ]; then
    NEED_SETUP=1
fi

if [ "$NEED_PLAYWRIGHT_NPM" -eq 1 ]; then
    npm install playwright --prefix "$SUBJECT_PATH"
fi

if [ "$NEED_SETUP" -eq 1 ]; then
    (cd "$SUBJECT_PATH" && npx playwright install chromium)
    touch "$PLAYWRIGHT_MARKER"
fi


node "$SUBJECT_PATH/get_subject.js" "$MODE" "$URL" "$SUBJECT_PATH" "$FILE_NAME" "$OTHER_PATH"