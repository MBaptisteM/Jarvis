#!/bin/bash
set -euo pipefail

MODE=$1
URL=$2
SUBJECT_PATH=$3

PLAYWRIGHT_MARKER="$SUBJECT_PATH/.playwright_setup_done"

if [ ! -f "$SUBJECT_PATH/package.json" ]; then
    npm init -y --prefix "$SUBJECT_PATH/"
fi

if [ ! -d "$SUBJECT_PATH/node_modules/playwright" ]; then
    npm install playwright --prefix "$SUBJECT_PATH/"
else
    echo "Playwright already installed, skipping."
fi

if [ ! -f "$PLAYWRIGHT_MARKER" ]; then
    sudo -v
    sudo env PATH="$PATH" npx --prefix "$SUBJECT_PATH/" playwright install-deps
    touch "$PLAYWRIGHT_MARKER"
else
    echo "Playwright system dependencies already installed, skipping."
fi

if [ ! -d "$HOME/.cache/ms-playwright" ] || [ -z "$(ls -A "$HOME/.cache/ms-playwright" 2>/dev/null)" ]; then
    npx --prefix "$SUBJECT_PATH/" playwright install
else
    echo "Playwright browsers already installed, skipping."
fi

node "$SUBJECT_PATH/get_subject.js" "$MODE" "$URL" "$SUBJECT_PATH"
