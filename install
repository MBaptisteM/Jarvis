#!/usr/bin/env bash

set -euo pipefail

ui_panel() {
    local kind=$1
    local title=$2
    shift 2

    local fd=1
    local border_color=""
    local title_color=""
    local reset=""
    case "$kind" in
        warning)
            fd=2
            border_color=$'\033[33m'
            title_color=$'\033[1;33m'
            ;;
        error)
            fd=2
            border_color=$'\033[31m'
            title_color=$'\033[1;31m'
            ;;
        success)
            border_color=$'\033[32m'
            title_color=$'\033[1;32m'
            ;;
        *)
            border_color=$'\033[90m'
            title_color=$'\033[1m'
            ;;
    esac

    if [[ ! -t $fd || -n "${NO_COLOR:-}" ]]; then
        border_color=""
        title_color=""
    else
        reset=$'\033[0m'
    fi

    local width=${#title}
    local line
    local i
    for line in "$@"; do
        if (( ${#line} > width )); then
            width=${#line}
        fi
    done
    (( width += 2 ))

    {
        printf '%s╭─ %s%s%s ' "$border_color" "$title_color" "$title" "$reset"
        local dashes=$(( width - ${#title} - 3 ))
        if (( dashes < 1 )); then
            dashes=1
        fi
        printf '%s' "$border_color"
        for ((i = 0; i < dashes; i++)); do
            printf '─'
        done
        printf '╮%s\n' "$reset"

        for line in "$@"; do
            printf '%s│%s %s%*s %s│%s\n' "$border_color" "$reset" "$line" \
                "$(( width - ${#line} - 2 ))" '' "$border_color" "$reset"
        done

        printf '%s╰' "$border_color"
        for ((i = 0; i < width; i++)); do
            printf '─'
        done
        printf '╯%s\n' "$reset"
    } >&"$fd"
}

ui_panel info "Install" "Installing Jarvis..."

NIX_PROFILE_PATH="$HOME/.nix-profile/bin:$HOME/.local/state/nix/profiles/profile/bin"
export PATH="$NIX_PROFILE_PATH:$PATH"

missing_packages=()
if ! command -v make >/dev/null 2>&1; then
    missing_packages+=("nixpkgs#gnumake")
elif ! make --version 2>/dev/null | grep -q '^GNU Make'; then
    missing_packages+=("nixpkgs#gnumake")
fi
if ! command -v cc >/dev/null 2>&1; then
    missing_packages+=("nixpkgs#gcc")
fi
if ! command -v git >/dev/null 2>&1; then
    missing_packages+=("nixpkgs#git")
fi

if ((${#missing_packages[@]})); then
    if ! command -v nix >/dev/null 2>&1; then
        ui_panel error "Missing build tools" \
            "Install Nix or provide make, cc, and git in PATH."
        exit 1
    fi
    if ! nix profile add "${missing_packages[@]}" >/dev/null; then
        ui_panel error "Installation failed" \
            "Could not install the required build tools with Nix."
        exit 1
    fi
    export PATH="$NIX_PROFILE_PATH:$PATH"
fi

for required_command in make cc git; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        ui_panel error "Missing build tool" \
            "Required command '$required_command' is unavailable after installing Nix packages."
        exit 1
    fi
done
if ! make --version 2>/dev/null | grep -q '^GNU Make'; then
    ui_panel error "Missing build tool" \
        "GNU Make is unavailable after installing Nix packages."
    exit 1
fi

ui_panel info "Build" "Building Jarvis..."
make --silent

BIN_PATH="$HOME/.local/bin"
LIB_PATH="$HOME/.local/lib/jarvis"
COMP_PATH="$HOME/.local/share/bash-completion/completions"

# EPITA environment: the local home is wiped on reboot, only ~/afs persists.
# Detected by the presence of the ~/afs folder.
is_epita_env() {
    [ -d "$HOME/afs" ]
}

if is_epita_env; then
    # Real data lives on AFS, ~/.jarvis is a symlink to it
    JARVIS_AFS_PATH="$HOME/afs/.confs/jarvis"
    JARVIS_DATA_PATH="$HOME/.jarvis"
    mkdir -p "$JARVIS_AFS_PATH"

    if [ -L "$JARVIS_DATA_PATH" ]; then
        # Already a symlink: (re)point it to the AFS folder
        ln -sfn "$JARVIS_AFS_PATH" "$JARVIS_DATA_PATH"
    else
        if [ -e "$JARVIS_DATA_PATH" ]; then
            # Existing real folder: move its content to AFS, then replace it
            cp -a "$JARVIS_DATA_PATH"/. "$JARVIS_AFS_PATH"/
            rm -rf "$JARVIS_DATA_PATH"
        fi
        ln -s "$JARVIS_AFS_PATH" "$JARVIS_DATA_PATH"
    fi

    # Register jarvis in the EPITA dotfiles list (dot_list) so that ~/.jarvis
    # is restored at each boot. Idempotent, with a one-time backup.
    EPITA_INSTALL_SH="$HOME/afs/.confs/install.sh"
    LIST_RE='^(dot_list|do_list)="'
    if [ ! -f "$EPITA_INSTALL_SH" ]; then
        ui_panel warning "EPITA" "$EPITA_INSTALL_SH not found: jarvis not added to dot_list."
    elif grep -Eq "${LIST_RE}([^\"]* )?jarvis( [^\"]*)?\"" "$EPITA_INSTALL_SH"; then
        :  # already registered
    elif grep -Eq "${LIST_RE}[^\"]*\"[[:space:]]*\$" "$EPITA_INSTALL_SH"; then
        [ -e "$EPITA_INSTALL_SH.bak" ] || cp "$EPITA_INSTALL_SH" "$EPITA_INSTALL_SH.bak"
        sed -E -i 's/^((dot_list|do_list)="[^"]*)"[[:space:]]*$/\1 jarvis"/' \
            "$EPITA_INSTALL_SH"
        ui_panel info "EPITA" "Added jarvis to dot_list in $EPITA_INSTALL_SH"
    else
        ui_panel warning "EPITA" \
            "Unrecognized dot_list format in $EPITA_INSTALL_SH:" \
            "add 'jarvis' to it manually."
    fi
elif [ -d "$HOME/.config" ]; then
    JARVIS_DATA_PATH="$HOME/.config/.jarvis"
else
    JARVIS_DATA_PATH="$HOME/.jarvis"
fi

mkdir -p "$BIN_PATH" "$LIB_PATH/cmd" "$COMP_PATH" "$JARVIS_DATA_PATH/subject"
cp bin/jarvis "$BIN_PATH/"
cp -R commands/. "$LIB_PATH/cmd/"
cp -R subject/. "$JARVIS_DATA_PATH/subject/"
cp completion/jarvis.bash "$COMP_PATH/jarvis"
cp completion/jarvis-shell.bash "$LIB_PATH/jarvis.bash"
cp completion/jarvis-shell.fish "$LIB_PATH/jarvis.fish"

chmod +x "$BIN_PATH/jarvis"
chmod +x "$LIB_PATH/cmd/"*

shell_name="${SHELL##*/}"
case "$shell_name" in
    bash)
        startup_file="$HOME/.bashrc"
        startup_line='export PATH="$HOME/.local/bin:$PATH"'
        integration_line='[ -r "$HOME/.local/lib/jarvis/jarvis.bash" ] && . "$HOME/.local/lib/jarvis/jarvis.bash"'
        ;;
    zsh)
        startup_file="$HOME/.zshrc"
        startup_line='export PATH="$HOME/.local/bin:$PATH"'
        integration_line='[ -r "$HOME/.local/lib/jarvis/jarvis.bash" ] && . "$HOME/.local/lib/jarvis/jarvis.bash"'
        ;;
    fish)
        startup_file="$HOME/.config/fish/config.fish"
        startup_line='fish_add_path "$HOME/.local/bin"'
        integration_line='source "$HOME/.local/lib/jarvis/jarvis.fish"'
        ;;
    *)
        startup_file="$HOME/.profile"
        startup_line='export PATH="$HOME/.local/bin:$PATH"'
        integration_line=""
        ;;
esac

mkdir -p "$(dirname "$startup_file")"
touch "$startup_file"
if ! grep -Fqx "$startup_line" "$startup_file"; then
    printf '%s\n' "$startup_line" >> "$startup_file"
fi
if [ -n "$integration_line" ] && ! grep -Fqx "$integration_line" "$startup_file"; then
    printf '%s\n' "$integration_line" >> "$startup_file"
fi

J_PATH="$BIN_PATH/j"
create_shortcut=0
shortcut_status=""
if [ -f "$J_PATH" ] && grep -q '^# Jarvis shortcut' "$J_PATH"; then
    create_shortcut=1
elif command -v j >/dev/null 2>&1; then
    shortcut_status="Shortcut j was not created because a command named 'j' already exists."
elif grep -Eq '^[[:space:]]*(alias j=|alias j |function j([[:space:]]|\(|$)|j[[:space:]]*\(\))' "$startup_file"; then
    shortcut_status="Shortcut j was not created because it is already defined in $startup_file."
else
    create_shortcut=1
fi

if [ "$create_shortcut" -eq 1 ]; then
    printf '#!/bin/sh\n# Jarvis shortcut\nexec jarvis "$@"\n' > "$J_PATH"
    chmod +x "$J_PATH"
    shortcut_status="Shortcut created: j = jarvis (ex: j c, j g, j pl)."

    # Autocompletion of "j" : same completion as "jarvis"
    cat > "$COMP_PATH/j" <<'COMPLETION_EOF'
# Jarvis shortcut : "j" is completed like "jarvis"
if [ -r "$HOME/.local/share/bash-completion/completions/jarvis" ]; then
    . "$HOME/.local/share/bash-completion/completions/jarvis"
fi
_jarvis_completion_function=$(complete -p jarvis 2>/dev/null | sed -n 's/.* -F \([^ ]*\).*/\1/p')
if [ -n "$_jarvis_completion_function" ]; then
    complete -F "$_jarvis_completion_function" j
fi
unset _jarvis_completion_function
COMPLETION_EOF
fi

# EPITA : ~/.local is wiped at reboot, so keep a copy of the installed
# commands on AFS (inside ~/.jarvis) and restore it when a shell starts.
if is_epita_env; then
    PERSIST_PATH="$JARVIS_DATA_PATH/install"
    rm -rf "$PERSIST_PATH"
    mkdir -p "$PERSIST_PATH/bin" "$PERSIST_PATH/lib" "$PERSIST_PATH/completions"

    cp "$BIN_PATH/jarvis" "$PERSIST_PATH/bin/"
    [ -f "$J_PATH" ] && cp "$J_PATH" "$PERSIST_PATH/bin/"
    cp -R "$LIB_PATH/." "$PERSIST_PATH/lib/"
    cp "$COMP_PATH/jarvis" "$PERSIST_PATH/completions/"
    [ -f "$COMP_PATH/j" ] && cp "$COMP_PATH/j" "$PERSIST_PATH/completions/"

    cat > "$JARVIS_DATA_PATH/restore" <<'RESTORE_EOF'
#!/bin/sh
# Jarvis : put the commands back after the local home was wiped (EPITA)
P="$HOME/.jarvis/install"
[ -d "$P" ] || exit 0
mkdir -p "$HOME/.local/bin" "$HOME/.local/lib/jarvis" \
         "$HOME/.local/share/bash-completion/completions"
cp -a "$P/bin/." "$HOME/.local/bin/"
cp -a "$P/lib/." "$HOME/.local/lib/jarvis/"
cp -a "$P/completions/." "$HOME/.local/share/bash-completion/completions/"
RESTORE_EOF
    chmod +x "$JARVIS_DATA_PATH/restore"

    if [ "$shell_name" = "fish" ]; then
        restore_line='test -x "$HOME/.local/bin/jarvis"; or sh "$HOME/.jarvis/restore"'
    else
        restore_line='[ -x "$HOME/.local/bin/jarvis" ] || sh "$HOME/.jarvis/restore"'
    fi
    if ! grep -Fqx "$restore_line" "$startup_file"; then
        # First line of the startup file, before the PATH / integration lines
        tmp_rc=$(mktemp)
        { printf '%s\n' "$restore_line"; cat "$startup_file"; } > "$tmp_rc"
        cat "$tmp_rc" > "$startup_file"
        rm -f "$tmp_rc"
    fi
fi

ui_panel success "Installation complete" \
    "Jarvis was installed successfully." \
    "Data directory: $JARVIS_DATA_PATH" \
    "Added ~/.local/bin to PATH and enabled shell navigation in $startup_file; this takes effect in new shells." \
    "$shortcut_status"
