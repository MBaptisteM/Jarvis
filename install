#!/bin/bash

set -euo pipefail

echo "Installing Jarvis..."

NIX_PROFILE_PATH="$HOME/.nix-profile/bin:$HOME/.local/state/nix/profiles/profile/bin"
export PATH="$NIX_PROFILE_PATH:$PATH"

missing_packages=()
if ! command -v make >/dev/null 2>&1; then
    missing_packages+=("nixpkgs#gnumake")
elif ! make --version 2>/dev/null | grep -q '^GNU Make'; then
    missing_packages+=("nixpkgs#gnumake")
fi
if ! command -v cc >/dev/null 2>&1; then
    missing_packages+=("nixpkgs#gcc")
fi
if ! command -v git >/dev/null 2>&1; then
    missing_packages+=("nixpkgs#git")
fi

if ((${#missing_packages[@]})); then
    if ! command -v nix >/dev/null 2>&1; then
        echo "Missing build tools. Install Nix or provide make, cc, and git in PATH." >&2
        exit 1
    fi
    nix profile add "${missing_packages[@]}"
    export PATH="$NIX_PROFILE_PATH:$PATH"
fi

for required_command in make cc git; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        echo "Required command '$required_command' is still unavailable after installing Nix packages." >&2
        exit 1
    fi
done
if ! make --version 2>/dev/null | grep -q '^GNU Make'; then
    echo "GNU Make is required and is still unavailable after installing Nix packages." >&2
    exit 1
fi

make

BIN_PATH="$HOME/.local/bin"
LIB_PATH="$HOME/.local/lib/jarvis"
COMP_PATH="$HOME/.local/share/bash-completion/completions"
if [ -d "$HOME/.config" ]; then
    JARVIS_DATA_PATH="$HOME/.config/.jarvis"
else
    JARVIS_DATA_PATH="$HOME/.jarvis"
fi

mkdir -p "$BIN_PATH" "$LIB_PATH/cmd" "$COMP_PATH" "$JARVIS_DATA_PATH/subject"
cp bin/jarvis "$BIN_PATH/"
cp -R commands/. "$LIB_PATH/cmd/"
cp -R subject/. "$JARVIS_DATA_PATH/subject/"
cp completion/jarvis.bash "$COMP_PATH/jarvis"

chmod +x "$BIN_PATH/jarvis"
chmod +x "$LIB_PATH/cmd/"*

echo "Installation complete!"
echo "Jarvis data directory: $JARVIS_DATA_PATH"

if ! grep -Fqx 'export PATH="$HOME/.local/bin:$PATH"' "$HOME/.bashrc" 2>/dev/null; then
    printf '%s\n' 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
    echo "Added ~/.local/bin to PATH in ~/.bashrc"
fi

echo "Open a new shell or run: export PATH=\"$HOME/.local/bin:\$PATH\""
